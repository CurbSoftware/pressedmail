{
  "$schema": "./manifest.schema.json",
  "version": "2.0.0",
  "layouts": {
    "pressedm": {
      "id": "pressedm",
      "name": "PressedM",
      "description": "Classic three-column email layout",
      "requiresPro": false,
      "php": {
        "class": "\\PressedMail\\Layouts\\DefaultLayout"
      },
      "react": {
        "module": "@/layouts/variants/default",
        "entry": "defaultLayoutParts"
      },
      "preview": {
        "sidebar": "bg-indigo-500",
        "list": "bg-slate-400 dark:bg-slate-600",
        "content": "bg-slate-200 dark:bg-slate-700"
      }
    },
    "pressedg": {
      "id": "pressedg",
      "name": "PressedG",
      "description": "Gmail-inspired conversation layout",
      "requiresPro": true,
      "php": {
        "class": "\\PressedMail\\Layouts\\PressedGLayout"
      },
      "react": {
        "module": "@/layouts/variants/pressedg",
        "entry": "pressedGLayoutParts"
      },
      "preview": {
        "sidebar": "bg-orange-500",
        "list": "bg-stone-400 dark:bg-stone-600",
        "content": "bg-stone-200 dark:bg-stone-700"
      }
    },
    "pressedout": {
      "id": "pressedout",
      "name": "PressedOut",
      "description": "Outlook-inspired ribbon layout",
      "requiresPro": true,
      "php": {
        "class": "\\PressedMail\\Layouts\\PressedOutLayout"
      },
      "react": {
        "module": "@/layouts/variants/pressedout",
        "entry": "pressedOutLayoutParts"
      },
      "preview": {
        "sidebar": "bg-blue-500",
        "list": "bg-sky-400 dark:bg-sky-600",
        "content": "bg-sky-200 dark:bg-sky-700"
      }
    }
  },
  "themes": {
    "pressedm": {
      "id": "pressedm",
      "name": "PressedM",
      "requiresPro": false,
      "category": "free",
      "colors": {
        "light": {
          "primary": "#6366f1",
          "secondary": "#64748b",
          "accent": "#f1f5f9"
        },
        "dark": {
          "primary": "#818cf8",
          "secondary": "#94a3b8",
          "accent": "#1e293b"
        }
      }
    },
    "curb": {
