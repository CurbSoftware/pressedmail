  "features": {
    "core": {
      "email_client": {
        "id": "email_client",
        "name": "Email Client",
        "description": "Basic email client functionality with IMAP/SMTP support",
        "php_class": "\\PressedMail\\Features\\Core\\EmailClient",
        "requires_license": false,
        "category": "core"
      },
      "dark_mode": {
        "id": "dark_mode",
        "name": "Dark Mode",
        "description": "Dark mode theme support for the email interface",
        "php_class": "\\PressedMail\\Features\\Core\\DarkMode",
        "requires_license": false,
        "category": "core"
      },
      "tags": {
        "id": "tags",
        "name": "Tags",
        "description": "Organize emails with custom tags",
        "php_class": "\\PressedMail\\Features\\Core\\Tags",
        "requires_license": false,
        "category": "inbox"
      },
      "folders": {
        "id": "folders",
        "name": "Folders",
        "description": "Custom and smart folders for organizing emails",
        "php_class": "\\PressedMail\\Features\\Core\\Folders",
        "requires_license": false,
        "category": "inbox"
      },
      "signatures": {
        "id": "signatures",
        "name": "Signatures",
        "description": "Create and manage email signatures",
        "php_class": "\\PressedMail\\Features\\Core\\Signatures",
        "requires_license": false,
        "category": "email"
      },
      "user_roles": {
        "id": "user_roles",
        "name": "User Roles",
        "description": "Role-based access control",
        "php_class": "\\PressedMail\\Features\\Core\\UserRoles",
        "requires_license": false,
        "category": "access"
      }
    },
    "premium": {
      "contacts": {
        "id": "contacts",
        "name": "Contact Book",
        "description": "Save and manage contacts for quick email addressing",
        "php_class": "\\PressedMail\\Features\\Core\\Contacts",
        "requires_license": true,
        "category": "productivity"
      },
      "calendar": {
        "id": "calendar",
        "name": "Calendar",
        "description": "Local calendar for scheduling events",
        "php_class": "\\PressedMail\\Features\\Pro\\Calendar",
        "requires_license": true,
        "category": "productivity"
      },
      "ai_integration": {
        "id": "ai_integration",
        "name": "AI Assistant",
        "description": "AI-powered email composition and summarization",
        "php_class": "\\PressedMail\\Features\\Pro\\AIIntegration",
        "requires_license": true,
        "category": "ai"
      },
      "phishing_detection": {
        "id": "phishing_detection",
        "name": "Phishing Detection",
        "description": "AI-powered detection of phishing emails",
        "php_class": "\\PressedMail\\Features\\Core\\PhishingDetection",
        "requires_license": true,
        "category": "security"
      },
      "themes": {
        "id": "themes",
        "name": "Custom Themes",
        "description": "Additional UI themes and customization options",
        "php_class": "\\PressedMail\\Features\\Pro\\Themes",
        "requires_license": true,
        "category": "customization"
      },
      "whitelabelling": {
        "id": "whitelabelling",
        "name": "Whitelabelling",
        "description": "Custom branding and remove PressedMail references",
        "php_class": "\\PressedMail\\Features\\Pro\\Whitelabelling",
        "requires_license": true,
        "extended_only": true,
        "category": "customization"
      },
      "admin_domain_allowlist": {
        "id": "admin_domain_allowlist",
        "name": "Allowed Email Domains",
        "description": "Authoritative managed IMAP and SMTP settings for approved email domains",
        "php_class": "\\PressedMail\\Features\\Pro\\AdminDomainAllowlist",
        "requires_license": true,
        "extended_only": false,
        "category": "access"
      }
    }
  },
  "build": {
    "free": {
      "variant": "free",
      "slug": "pressedmail",
      "name": "PressedMail",
      "description": "A modern email client in your WordPress admin dashboard",
      "featureFlags": {
        "isPro": false,
        "entitlements": {
          "white_label": false
        },
        "features": {
          "layouts": {
            "enabled": true,
            "available": [
              "pressedm"
            ]
          },
          "themes": {
            "enabled": true,
            "available": [
              "pressedm",
              "contrast"
            ]
          },
          "email_accounts": {
            "enabled": true,
            "limit": -1
          },
          "users": {
            "enabled": true,
            "limit": -1
          },
          "tags": {
            "enabled": true,
            "limit": -1
          },
          "folders": {
            "enabled": true,
            "type": "imap_only"
          },
          "signatures": {
            "enabled": true,
            "limit": -1
          },
          "email_rules": {
            "enabled": true,
            "limit": -1
          },
          "user_roles": {
            "enabled": true,
            "type": "all_users"
          },
          "phishing_detection": false,
          "prevent_impersonation": true,
          "contacts": false,
          "contact_lists": {
            "enabled": false,
            "limit": 0
          },
          "calendar": false,
          "calendars": {
            "enabled": false,
            "limit": 0
          },
          "snooze": false,
          "undo_send": false,
          "snippets": {
            "enabled": false,
            "limit": 0
          },
          "signature_rules": false,
          "sender_aliases": {
            "enabled": false,
            "limit": 0
          },
          "email_tracking": false,
          "auto_followups": false,
          "auto_replies": false,
          "scheduled_emails": false,
          "smart_inbox": false,
          "auto_tagger": false,
          "ai_integration": {
            "enabled": false,
            "type": "none"
          }
        }
      }
    }
  },
  "baseIncludes": [
    "pressedmail.php",
    "plugin.php",
    "uninstall.php",
    "readme.txt",
    "LICENSE.txt",
    "composer.json",
    "includes",
    "libs",
    "database",
    "assets",
    "languages"
  ],
  "alwaysExclude": [
    "**/.git",
    "**/.github",
    "**/.vscode",
    "**/.idea",
    "**/.DS_Store",
    "**/node_modules",
    "**/*.map",
    "**/*.log",
    "**/.env",
    "**/.env.*",
    "**/tests",
    "**/test",
    "**/Tests",
    "**/Test",
    "**/*.test.php",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.mjs",
    "**/coverage",
    "**/storybook-static",
    "**/cache",
    "**/vendor/bin",
    "**/nesbot/carbon/bin",
    "**/nesbot/carbon/src/Carbon/Lang",
    "**/illuminate/support/Testing",
    "**/.gitignore",
    "**/.gitattributes",
    "**/.editorconfig",
    "**/.deepsource.toml",
    "**/.phpstorm.meta.php",
    "**/vendor/**/README.md",
    "**/vendor/**/readme.md",
    "**/vendor/**/CHANGELOG.md",
    "**/vendor/**/CODE_OF_CONDUCT.md",
    "**/vendor/**/SECURITY.md",
    "**/vendor/**/CONTRIBUTING.md",
    "**/vendor/**/UPGRADE.md",
    "languages/*.po",
    "**/phpunit.xml",
    "**/phpunit.xml.dist",
    "**/vite-dev-server.json",
    "**/integrity-manifest.json",
    "**/module-graph.json",
    "assets/admin/dist-free",
    "assets/admin/dist-pro",
    "assets/frontend",
    "libs/assets-dev.php"
  ]
}
